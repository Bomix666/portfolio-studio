# ---------------------------------------------------------------------------
# Скопируйте в .env.local для разработки. Никогда не коммитьте реальные значения.
# В браузер попадают только переменные с префиксом NEXT_PUBLIC_ — секреты держите без него.
# ---------------------------------------------------------------------------

# Публичный адрес сайта (метаданные, sitemap, canonical-ссылки, проверка Origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Форма заявки ------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО в продакшне. 32+ случайных символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET=

# Адаптер доставки: resend | webhook | console (console — только лог в разработке)
# В разработке по умолчанию "console"; в продакшне без адаптера форма заявки не принимает.
CONTACT_PROVIDER=console

# Куда отправлять заявки (resend)
CONTACT_TO_EMAIL=
# Подтверждённый отправитель, например "Studio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Resend — https://resend.com (только на сервере)
RESEND_API_KEY=

# Универсальный вебхук (Slack, Zapier, Make, n8n, CRM…)
CONTACT_WEBHOOK_URL=
# Необязательно: подписывает тело как X-Signature: sha256=<hex>
CONTACT_WEBHOOK_SECRET=

# "true" — только за прокси, который выставляет X-Forwarded-For / X-Real-IP
# (Vercel, Cloudflare, ваш Nginx). Включает лимиты по IP.
TRUST_PROXY=false
